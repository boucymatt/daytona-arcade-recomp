void main(float4 position : POSITION, float4 uv : COLOR0, float4 mapping : TEXCOORD0,
          float4 bounds : TEXCOORD1, float4 modes : TEXCOORD2,
          out float4 clip : POSITION, out float4 colour : COLOR0,
          out float2 native_pixel : TEXCOORD0, out float4 texture_mapping : TEXCOORD1,
          out float4 texture_bounds : TEXCOORD2, out float4 texture_modes : TEXCOORD3) {
    clip = position;
    colour = uv;
    texture_mapping = mapping;
    texture_bounds = bounds;
    texture_modes = modes;
    native_pixel = float2((position.x + 1.0) * 248.0, (1.0 - position.y) * 192.0);
}
